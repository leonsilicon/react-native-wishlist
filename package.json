{
  "name": "@leonsilicon/react-native-wishlist",
  "version": "0.0.7",
  "description": "The fastest List component for React Native updated to work with Expo 55",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "start": "cd example && vpr start",
    "ios": "cd example && vpr ios",
    "android": "cd example && vpr android",
    "test": "jest",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it",
    "bootstrap": "vp install && cd example && vpr pods",
    "format:clang:check": "clang-format --dry-run --Werror --glob='{ios,android,cpp}/**/*.{h,cpp,m,mm}'",
    "format:clang:write": "clang-format -i --glob='{ios,android,cpp}/**/*.{h,hpp,cpp,m,mm}'"
  },
  "keywords": [
    "react-native",
    "react-native-wishlist",
    "ios",
    "android",
    "fast",
    "infinite",
    "list",
    "wishlist",
    "margelo",
    "flatlist",
    "scroll",
    "scrollview",
    "flashlist",
    "recyclerlist",
    "recycling",
    "recycled",
    "virtualized"
  ],
  "repository": "https://github.com/margelo/react-native-wishlist",
  "author": {
    "name": "Margelo",
    "email": "hello@margelo.io",
    "url": "http://margelo.io/"
  },
  "contributors": [
    {
      "name": "Marc Rousavy",
      "email": "marc@margelo.io",
      "url": "https://github.com/mrousavy"
    },
    {
      "name": "Szymon Kapala",
      "email": "szymon@margelo.io",
      "url": "https://github.com/Szymon20000"
    },
    {
      "name": "Janic Duplessis",
      "email": "janic@margelo.io",
      "url": "https://github.com/janicduplessis"
    },
    {
      "name": "Terry Sahaidak",
      "email": "terry@margelo.io",
      "url": "https://github.com/terrysahaidak"
    },
    {
      "name": "Christian Falch",
      "email": "christian.falch@gmail.com",
      "url": "https://github.com/chrfalch"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/react-native-wishlist/issues"
  },
  "homepage": "https://github.com/margelo/react-native-wishlist#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "denque": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@jamesacarr/eslint-formatter-github-actions": "catalog:",
    "@react-native-community/eslint-config": "catalog:",
    "@release-it/conventional-changelog": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "clang-format": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "jest": "catalog:",
    "pod-install": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-worklets": "catalog:",
    "react-native-worklets-core": "catalog:",
    "release-it": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-worklets-core": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "wishlist",
    "type": "all",
    "jsSrcsDir": "./src/Specs",
    "android": {
      "javaPackageName": "com.wishlist"
    }
  },
  "workspaces": [
    ".",
    "example"
  ],
  "packageManager": "pnpm@11.1.1"
}
