{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
    }
  },
  "include": [
    "src/App.tsx",
    "src/app/**/*.tsx",
    "src/AssetList/**/*.ts",
    "src/AssetList/**/*.tsx",
    "src/Chat/**/*.ts",
    "src/Chat/**/*.tsx",
    "../src/global.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
